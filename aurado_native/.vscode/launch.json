{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run Aurado (with .env)",
            "request": "launch",
            "type": "dart",
            "program": "lib/main.dart",
            "toolArgs": [
                "--dart-define-from-file=.env"
            ]
        },
        {
            "name": "Run Aurado Release (with .env)",
            "request": "launch",
            "type": "dart",
            "program": "lib/main.dart",
            "flutterMode": "release",
            "toolArgs": [
                "--dart-define-from-file=.env"
            ]
        }
    ]
}
